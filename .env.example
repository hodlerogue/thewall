# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# From a hosted project: Project Settings -> API.
# From `supabase start`: the values it prints on startup.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ — it bypasses every RLS
# policy. Used solely to mint magic links in the signup flow (§3.9).
SUPABASE_SERVICE_ROLE_KEY=

# Where the magic link sends people back to. Must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sending the key (§4.7). Leave both blank and the link goes to the server log
# instead, which is how this runs locally — nothing breaks, you just read the
# link from the console.
#
# MAIL_FROM has to be an address at a domain verified with the provider, so
# thewall.social needs its DNS records added there first.
RESEND_API_KEY=
MAIL_FROM=thewall <key@thewall.social>
